 import { dev } from '$app/environment';
 import type { Handle } from '@sveltejs/kit';
 
+// Bench: the host owns SQLite and answers platform.invoke('query'). The SQL of
+// $lib/db is Postgres; it is rewritten for SQLite here, once per statement.
+const rewritten = new Map<string, string>();
+
+function sqlite(sql: string): string {
+  let out = rewritten.get(sql);
+
+  if (out === undefined) {
+    out = sql
+      .replace(/(\w+)::float/g, 'CAST($1 AS REAL)')
+      .replace(/(\$\d+|\w+)::(uuid|int|text)/g, '$1')
+      .replace(/\$\d+/g, '?');
+    rewritten.set(sql, out);
+  }
+
+  return out;
+}
+
 export const handle: Handle = async ({ event, resolve }) => {
   if (dev && !event.platform) {
     const { DevDatabase } = await import('$lib/database-dev');
@@ -9,6 +27,16 @@ export const handle: Handle = async ({ event, resolve }) => {
         DATABASE: new DevDatabase()
       }
     };
+  } else if (event.platform && !event.platform.env.DATABASE && event.platform.invoke) {
+    const platform = event.platform;
+    const invoke = platform.invoke;
+    const DATABASE = {
+      query: (sql: string, params?: unknown[]) =>
+        invoke('query', { sql: sqlite(sql), params: params ?? [] })
+    } as BindingDatabase;
+
+    // The env of a host may not take new keys: give the app a copy
